# Railway — TEMPLATE, no values. Paste into Variables → ⋮ → Raw Editor.
#
# Two services live here: worker and ws-gateway. They do NOT take the same set.
# Reference: deploy/ENVIRONMENT.md · Cutover order: deploy/MIGRATE-HOSTING.md
#
# To read the current values (raw secrets — paste straight across, do not save):
#   railway variables list --service worker --kv
#   railway variables list --service ws-gateway --kv

# ===========================================================================
# WORKER
# ===========================================================================

# --- Database (from deploy/supabase.env.example, WORKER pool settings) ------
# connection_limit=10, not 1. The serverless value belongs on Vercel only.
DATABASE_URL=
SERVICE_DATABASE_URL=

# --- Redis ------------------------------------------------------------------
# A REFERENCE to the Redis service in THIS project, not a copied literal.
# A pasted URL from the old project points the new worker at the old queue.
REDIS_URL=

# --- Must match Vercel exactly ----------------------------------------------
# Every stored Shopify token is AES-256-GCM ciphertext under this key. A new
# value makes every live connection undecryptable, and nothing recovers them.
TOKEN_ENCRYPTION_KEY=

# --- The app's own public origin --------------------------------------------
# Builds the webhook callback URL the worker registers with Shopify. If this
# changes, merchants who registered their own Shopify app must update their
# redirect URI too — see the runbook before changing it.
SHOPIFY_APP_URL=

# --- Mail -------------------------------------------------------------------
# With NODE_ENV=production an unset key makes every send THROW rather than
# falling back to the console. It cannot be blank on a production host.
RESEND_API_KEY=
EMAIL_FROM=

# --- POS pull feed ----------------------------------------------------------
# Only matters for tenants with TenantConfig.posFeedUrl set.
POS_FEED_SECRET=

# --- Error tracking ---------------------------------------------------------
# The tracker is a complete no-op while the DSN is unset — errors are not
# "captured quietly", they are not captured at all.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- Schedules: all OFF until the database is verified ----------------------
# Set each to 1 only AFTER the restore checks pass. A cron firing mid-cutover
# writes to whichever database the worker is pointed at right then.
# Leaving one unset is a silent half-migration: without SHOPIFY_SYNC_CRON a
# shop's data only refreshes when someone presses Sync now, and the buy list
# ages without saying so.
FORECAST_CRON=
SHOPIFY_SYNC_CRON=
SNAPSHOT_CRON=
EMAIL_CRONS=
OPS_CRONS=
POS_CRONS=
COST_CRONS=
# Optional: only to re-time the sync. Default */15 * * * *. Ten minutes is the
# floor worth considering — a tick does a full inventory refresh.
SHOPIFY_SYNC_PATTERN=

# ===========================================================================
# WS-GATEWAY
# ===========================================================================
# Same database and Redis as the worker. No mail, no crons, no encryption key.
# PORT is injected by Railway — never set it by hand.

DATABASE_URL=
SERVICE_DATABASE_URL=
REDIS_URL=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# WS_DEV_TOKEN is for non-production environments ONLY. It must not exist on a
# production gateway: it accepts tokens that are not real sessions.
