# Database — same three roles as packages/db/.env.example.
DATABASE_URL=postgresql://wezesha_app:wezesha_app_dev@localhost:5434/wezesha
SERVICE_DATABASE_URL=postgresql://wezesha_service:wezesha_service_dev@localhost:5434/wezesha
DIRECT_URL=postgresql://postgres:postgres@localhost:5434/wezesha

# Better Auth. Secret signs session cookies — generate a real one per
# environment (`openssl rand -base64 32`); URL is the app's public origin.
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:3000

# There is no shared Shopify app and no SHOPIFY_API_KEY / SHOPIFY_API_SECRET:
# every workspace stores its own client credentials in the database, and the
# resolver takes no environment fallback (apps/web/lib/shopify/credentials.ts).
#
# Public origin Shopify redirects back to and delivers webhooks at (no trailing
# slash). Locally that means a tunnel (e.g. cloudflared) in front of the web app.
SHOPIFY_APP_URL=http://localhost:3000

# AES-256 key for integration tokens at rest (32 bytes, base64):
# `openssl rand -base64 32`. Must match the worker's copy.
TOKEN_ENCRYPTION_KEY=

# Sync queue + realtime publishing. /api/health also reads it to report the
# worker heartbeat.
REDIS_URL=redis://localhost:6380

# Transactional email (Resend). With no RESEND_API_KEY set, outbound mail (sign-in
# codes, invites, password resets, POs) is logged to the server console instead
# of sent — fine for local dev and the tests. EMAIL_FROM is the sender, given as
# "Name <address>" or a bare address; required once RESEND_API_KEY is set.
RESEND_API_KEY=
EMAIL_FROM=Wezesha Restock <no-reply@example.com>

# Cross-tenant admin console (/admin) allow-list: comma-separated account
# emails, case-insensitive. Unset or empty = the console is off (404 for
# everyone). Keep this to named operators only.
ADMIN_EMAILS=
# Error tracking (optional). Unset = tracking disabled entirely — the SDK is
# not even loaded. Set per environment once the Sentry project exists.
SENTRY_DSN=
