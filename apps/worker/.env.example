# Worker env. Copied to apps/worker/.env by `npm run setup`; the dev script
# loads that file if it exists. Every variable the worker reads is listed here —
# the source of truth is the header comment in apps/worker/src/index.ts.
#
# In production these are set on the platform, not from a file.

# Database — the same three roles as packages/db/.env.example. The worker writes
# through the BYPASSRLS service role (cron jobs and the Shopify sync have no
# single tenant context); DATABASE_URL is what the Prisma client is constructed
# with. Without a file here the worker still picks these up from packages/db/.env,
# because the Prisma client loads the env file next to its schema.
DATABASE_URL=postgresql://wezesha_app:wezesha_app_dev@localhost:5434/wezesha
SERVICE_DATABASE_URL=postgresql://wezesha_service:wezesha_service_dev@localhost:5434/wezesha

# Queues + realtime publishing. Defaults to this value when unset, which is what
# docker compose publishes locally.
REDIS_URL=redis://localhost:6380

# Decrypts stored Shopify tokens (32 bytes, base64: `openssl rand -base64 32`).
# Must be the same value the web app uses, or every sync fails to decrypt.
TOKEN_ENCRYPTION_KEY=

# Public web origin. Webhook callbacks are registered against it during a sync;
# unset means no webhooks and the scheduled poll carries the load. Falls back to
# BETTER_AUTH_URL, which is normally the same value.
SHOPIFY_APP_URL=
BETTER_AUTH_URL=http://localhost:3000

# Outbound mail. With no RESEND_API_KEY the worker logs mail to the console
# instead of sending it. EMAIL_FROM is "Name <address>" or a bare address, and is
# required once RESEND_API_KEY is set.
RESEND_API_KEY=
EMAIL_FROM=Wezesha Restock <no-reply@example.com>

# Bearer token for the POS feed fetch (per provider).
POS_FEED_SECRET=

# Cron switches. Each group registers its schedules ONLY when set to 1, so a
# worker with none of these set runs no nightly work — no forecast, no on-hand
# snapshots, and therefore no stockout-rate or dead-stock trend. Left off here so
# a local worker stays quiet; turn on the ones you're testing.
FORECAST_CRON=
SNAPSHOT_CRON=
COST_CRONS=
POS_CRONS=
OPS_CRONS=
EMAIL_CRONS=
SHOPIFY_SYNC_CRON=
# Cron pattern for the recurring Shopify sync (default: every 15 minutes).
SHOPIFY_SYNC_PATTERN=

# Error tracking. Unset = the tracker is never initialised.
SENTRY_DSN=
