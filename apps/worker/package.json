{
  "name": "@wezesha/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Background job runner: BullMQ queues with per-tenant no-overlap guards",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx src/index.ts",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wezesha/db": "*",
    "@wezesha/forecast": "*",
    "@wezesha/forecast-run": "*",
    "@wezesha/observability": "*",
    "@wezesha/pos": "*",
    "@wezesha/quickbooks": "*",
    "@wezesha/queue": "*",
    "@wezesha/realtime": "*",
    "@wezesha/shopify": "*",
    "bullmq": "^5.80.11",
    "ioredis": "^5.11.1",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "dotenv": "^16.6.1",
    "eslint": "^9.39.5",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.7",
    "ws": "^8.21.1"
  }
}
