generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // wezesha_app — RLS enforced
  directUrl = env("DIRECT_URL") // owner role — migrations only
}

// ── Auth (global) ────────────────────────────────────────────────────────────
// Better Auth's tables. Users are system-scope (a user can belong to several
// tenants via Membership), so none of these carry tenantId and none get an RLS
// policy — they are allow-listed as GLOBAL_TABLES in the coverage census.
// Field set matches Better Auth's Prisma schema; auth reads/writes go through
// the service client (prismaAuth).

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions    Session[]
  accounts    Account[]
  memberships Membership[]

  @@unique([email])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ── Tenancy core ─────────────────────────────────────────────────────────────
// Every tenant-owned table carries tenantId and a tenant_isolation RLS policy
// (appended in its migration). Tenant and the auth tables are the only globals.

model Tenant {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  timezone      String   @default("Africa/Nairobi")
  currency      String   @default("KES")
  source        String   @default("shopify") // "shopify" | "odoo"
  // Seed for PO numbering: new POs continue from max(existing PO-####, this), so
  // Wezesha's numbers carry on from QuickBooks' latest (set once to QB's current max).
  poNumberFloor Int      @default(0)
  // Billing plan key ("starter" | "growth" | "scale"). null = starter. Tiers and
  // their usage limits are code-defined in src/limits.ts, not a table.
  plan          String?
  // Per-tenant limit overrides: { maxProducts?, maxMembers?, maxOrders30d? }.
  // null = the plan's code defaults; a set key overrides just that limit.
  planLimits    Json?
  createdAt     DateTime @default(now())

  memberships           Membership[]
  tenantConfig          TenantConfig?
  products              Product[]
  suppliers             Supplier[]
  locations             Location[]
  inventorySnapshots    InventorySnapshot[]
  warehouseLocationMaps WarehouseLocationMap[]
  ignoreRules           IgnoreRule[]
  savedFilters          SavedFilter[]
  salesHistory          SalesHistory[]
  posSales              PosSale[]
  monthlyContext        MonthlyContext[]
  promos                Promo[]
  predictions           Prediction[]
  ownerPriors           OwnerPrior[]
  orders                Order[]
  purchaseOrders        PurchaseOrder[]
  distributionPlans     DistributionPlan[]
  shopifyConnection     ShopifyConnection?
  ingestCursors         IngestCursor[]
  notifications         Notification[]
  locationClosures      LocationClosure[]
  productPlanOverrides  ProductPlanOverride[]
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

model Membership {
  id                   String    @id @default(cuid())
  userId               String // local auth User.id
  tenantId             String
  role                 Role      @default(OWNER)
  // Human display name (users are otherwise email-only).
  displayName          String?
  // Explicit per-user permission keys. null = inherit the role's preset; a
  // non-null array (even empty) is an admin override.
  permissions          Json?
  // First time this member finished the welcome/guide. null = show first-run extras.
  welcomedAt           DateTime?
  // Terms & Conditions consent (server-enforced in the shop layout). Accepted iff
  // acceptedTermsAt set AND acceptedTermsVersion == current TERMS_VERSION.
  acceptedTermsAt      DateTime?
  acceptedTermsVersion String?
  createdAt            DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model TenantConfig {
  id       String @id @default(cuid())
  tenantId String @unique

  // Integrations
  posFeedUrl  String? // POS feed base URL (e.g. Dellwest)
  posFeedSlug String? // ingest slug (defaults to tenant slug)
  alertEmail  String? // where forecast-health / digest alerts go
  notifyPrefs Json? // { phantomPo, lowStockDigest, syncFailure, weeklySpotCheck: bool }

  // Curated forecast knobs (null = code default)
  serviceLevelZA   Float? // overrides A z
  serviceLevelZB   Float? // overrides B z
  serviceLevelZC   Float? // overrides C z
  orderCapMultiple Float? // overrides the forecast cap multiple

  // Dead-stock lookback window (days with no sale = dead). null = code default.
  deadStockWindowDays Int?

  // Per-ABC-class ordering method (null = recommended default):
  // "stay_in_stock" | "balanced" | "lean_cash".
  methodA String?
  methodB String?
  methodC String?

  // Champion demand method per ABC class, chosen by the monthly walk-forward
  // audition (spec §6). Run rate is the reigning champion; a challenger only
  // lands here after beating it on the shop's own history. Shape:
  // { A: "run_rate", B: "run_rate", C: "run_rate", auditedAt: "<iso>" }.
  // The user never picks a model and never sees these names.
  forecastChampions Json?

  // When this tenant first went over any plan limit (grace window anchor).
  // Cleared when usage drops back under; null = within limits.
  limitsExceededAt DateTime?

  // Per-tenant feature switches (capability gate 4): { transfers?, pos_feed?,
  // quickbooks?, supplier_email?, weekly_digest?: bool }. An absent key falls
  // back to its documented default (see lib/capabilities/feature-flags.ts);
  // Settings toggles write here. null = every flag at its default.
  featureFlags Json?

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ── Catalog & inventory ──────────────────────────────────────────────────────

model Product {
  id                String    @id @default(cuid())
  tenantId          String
  shopifyProductId  String? // nullable: Odoo rows carry externalId+source instead
  shopifyVariantId  String?
  externalId        String? // provider record id (Odoo product.product id, etc.)
  source            String    @default("shopify") // "shopify" | "odoo"
  sku               String
  title             String
  vendor            String?
  productType       String?
  priceKes          Float     @default(0)
  costKes           Float     @default(0)
  imageUrl          String?
  currentStock      Float     @default(0)
  abcCategory       String?
  // Owner-defined grouping (the "Category" facet), seeded from Shopify
  // productType and freely re-grouped by the owner. null = uncategorised. The
  // old Local/Korean/Western importCategory vocabulary is retired; nothing
  // depends on this value — clearing it just drops the row from that facet.
  customCategory    String?
  dailySalesRate    Float     @default(0)
  lastSynced        DateTime  @default(now())
  shopifyCreatedAt  DateTime? // when the SKU was first created in Shopify — product age signal (dead-stock: new vs old dud)
  supplierId        String?
  onOrder           Int       @default(0)
  expectedArrivalAt DateTime?
  receivedAt        DateTime?
  leadTimeDays      Int? // per-product lead-time override (days); null → supplier default
  active            Boolean   @default(true) // false = not in QB (or owner-deactivated) → out of the buy list
  activeOverride    Boolean   @default(false) // owner pinned active; the QB flagger must never deactivate it
  qbMatchedAt       DateTime? // last time the QB catalogue feed confirmed this product (null = never)
  notForSale        Boolean   @default(false) // tester/display/damaged: visible in catalogue, out of sellable stock, cover and the buy list
  costSource        String? // "manual" (pinned, wins) | "qb" | "shopify"; null = missing → held off the buy list
  costUpdatedAt     DateTime? // when costKes last changed (any source) — freshness behind the source label + audit
  lastSyncedCostKes Float? // last SYNCED cost (shopify/qb) the cost-moved check saw; the prior-cost signal for the >20% diff. null = no baseline captured yet
  costMovedPct      Float? // last detected synced-cost jump, signed % (e.g. 18, -22); null = no active alert
  costMovedAt       DateTime? // when that jump was detected (drives the attention row + "since" copy); null = none

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier           Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  inventoryLevels    InventoryLevel[]
  inventorySnapshots InventorySnapshot[]
  salesHistory       SalesHistory[]
  predictions        Prediction[]
  posSaleLines       PosSaleLine[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([tenantId, shopifyProductId])
  @@unique([tenantId, source, externalId])
  @@index([tenantId])
  @@index([tenantId, source])
  @@index([tenantId, productType])
  @@index([tenantId, vendor])
  @@index([tenantId, active])
  @@index([tenantId, notForSale])
  @@index([tenantId, customCategory])
}

model Supplier {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  email           String? // where "Email to supplier" sends the PO; null = not captured yet
  country         String?
  currency        String    @default("USD")
  // null = unknown. Deliberately no default: a guessed lead time silently skews
  // reorder points, so the value stays empty until the owner supplies it.
  leadTimeAvgDays Int?
  leadTimeStdDays Int       @default(7)
  moq             Int       @default(1)
  // Optional owner label ("Overseas", "Local pickup", "Fast restock"). Shown as
  // the Group column and usable as a planner scope; nothing depends on it, and
  // the filter's options derive from the labels actually in use.
  supplierGroup   String?
  notes           String?
  createdAt       DateTime  @default(now())
  deletedAt       DateTime? // soft-delete: hidden from lists; product links + history kept

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@index([tenantId])
}

model Location {
  id                String  @id @default(cuid())
  tenantId          String
  shopifyLocationId String?
  externalId        String?
  source            String  @default("shopify")
  name              String
  isPrimary         Boolean @default(false)
  // Owner-set role. The stored value is the DB enum; the CALCULATION ROLE it
  // maps to (see @wezesha/db roleOf / lib/locations/roles) drives the math:
  //   "branch"    → Sells   — on-hand available to sell (days-of-cover, reorder)
  //   "warehouse" → Holds   — distributable stock (transfer suggestions only)
  //   "enroute"   → En-route— on-order (feeds Product.onOrder; never on-hand)
  //   "virtual"   → Ignore  — counts as nothing, excluded everywhere
  // null = not yet classified (treated as "branch"/Sells — the safe default).
  locationType      String?
  // Role provenance: guessed from the name ("assumed") or owner-confirmed
  // ("confirmed"). null = treated as assumed. The sync only ever writes an
  // "assumed" guess; it never overwrites a "confirmed" role.
  roleStatus        String?

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventoryLevels       InventoryLevel[]
  warehouseLocationMaps WarehouseLocationMap[]
  salesHistory          SalesHistory[]
  closures              LocationClosure[]
  distributionPlansFrom DistributionPlan[]     @relation("DistFrom")
  distributionLinesTo   DistributionPlanLine[] @relation("DistTo")

  @@unique([tenantId, shopifyLocationId])
  @@unique([tenantId, source, externalId])
  @@index([tenantId])
}

model InventoryLevel {
  id         String   @id @default(cuid())
  tenantId   String
  locationId String
  productId  String
  onHand     Int      @default(0) // on_hand quantity, NOT available
  incoming   Int      @default(0) // Shopify "incoming" quantity at this location (in-transit to it); feeds the in-transit-between-branches number, never sellable on-hand
  updatedAt  DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([locationId, productId])
  @@index([tenantId])
}

model InventorySnapshot {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  date      DateTime // UTC midnight of the snapshot day
  onHand    Float

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([tenantId, date])
}

// Per-tenant map: a raw POS warehouse name → a Location, so physical-branch
// run rate attributes to the right location.
model WarehouseLocationMap {
  id            String @id @default(cuid())
  tenantId      String
  warehouseName String
  locationId    String

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([tenantId, warehouseName])
  @@index([tenantId])
}

// Permanent "never ask again" rules: junk till SKUs ("not a product": carrier
// bags, airtime) and ignored QuickBooks items (services, fees).
model IgnoreRule {
  id              String   @id @default(cuid())
  tenantId        String
  kind            String // "till_sku" | "qb_item"
  value           String // the till SKU or QB item id/name being ignored
  createdByUserId String?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, value])
  @@index([tenantId, kind])
}

// Saved filters / segments per member per list screen ("saved views";
// also reusable as planner scopes).
model SavedFilter {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String // auth User.id (deliberately no FK — views are cheap per-member state)
  page      String // "products" | "planner" | "orders" | ...
  name      String
  query     Json // the serialized filter state
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, page])
}

// ── Sales & forecasting ──────────────────────────────────────────────────────

model SalesHistory {
  id         String   @id @default(cuid())
  tenantId   String
  productId  String
  date       DateTime
  quantity   Float
  revenueKes Float
  channel    String   @default("shopify")
  // Fulfilment location (which branch shipped/sold this) for per-branch run
  // rate. Populated by the sync when an order's fulfilment location is
  // unambiguous; null = unattributed (POS/legacy rows, multi-branch days, or
  // pre-attribution history). SetNull so deactivating a location keeps history.
  locationId String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([productId, date, channel])
  @@index([tenantId, date])
  @@index([tenantId, locationId])
}

// Raw POS sale (physical shop). Powers run-rate (via SalesHistory channel="pos")
// and the who-sold/warehouse audit. Online ("SHOPIFY") sales are filtered out
// upstream — they already arrive via the Shopify sync.
model PosSale {
  id            String   @id @default(cuid())
  tenantId      String
  externalId    String // POS provider sale id
  reference     String?
  date          DateTime
  createdBy     String // staff name (physical); "SHOPIFY" rows are excluded upstream
  salesAgent    String?
  warehouse     String?
  customer      String?
  saleStatus    String?
  paymentStatus String?
  grandTotal    Float    @default(0)
  channel       String   @default("physical")
  createdAt     DateTime @default(now())

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  PosSaleLine[]

  @@unique([tenantId, externalId])
  @@index([tenantId, date])
}

model PosSaleLine {
  id          String  @id @default(cuid())
  posSaleId   String
  tenantId    String // denormalised for RLS (uniform tenant_isolation policy)
  sku         String
  productName String
  qty         Float   @default(0)
  price       Float   @default(0)
  subtotal    Float   @default(0)
  productId   String? // matched product (by SKU); null = unmatched POS code

  posSale PosSale  @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, productId])
  @@index([posSaleId])
}

// A branch marked closed for a day — the "shop was closed" dismissal of a sales
// gap (spec §3). Distinct from a feed problem: a closure is a genuine no-trading
// day the forecast should honour later (not counted as lost sales), so it is a
// record, not just a dismissed alert. One row per (location, day).
model LocationClosure {
  id              String   @id @default(cuid())
  tenantId        String
  locationId      String
  date            DateTime // UTC-midnight marker for the tenant-local closed day
  reason          String   @default("closed")
  note            String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, date])
  @@index([tenantId, date])
}

model MonthlyContext {
  id                  String   @id @default(cuid())
  tenantId            String
  month               String
  marketingBudget     Float?
  promotions          String?
  seasonalExpectation String?
  cashFlow            String?
  notes               String?
  createdAt           DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, month])
}

model Promo {
  id          String    @id @default(cuid())
  tenantId    String
  startDate   DateTime
  endDate     DateTime
  scope       String    @default("all")
  scopeValue  String?
  discountPct Float     @default(0)
  promoType   String    @default("flash")
  channel     String    @default("all")
  notes       String?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime? // soft-delete: hidden from lists + excluded from forecast promo windows

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, startDate])
}

model Prediction {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  runDate   DateTime @default(now())

  layer1Forecast30d Float
  layer1Confidence  Float
  layer2Adjustment  Float
  finalForecast30d  Float
  daysUntilStockout Int
  recommendedQty    Float
  safetyStock       Float
  reorderPoint      Float
  confidence        Float
  reasoning         String
  urgency           String
  signals           String
  forecastRunId     String  @default(cuid())
  regime            String?
  // Per-driver forecast breakdown parts (the QtyExplanation object); the forecast
  // run persists these so the "why" is read back, not recomputed per screen.
  explainParts      Json?
  // The honesty word travelling with this number: "sure" | "fairly_sure" |
  // "guessing" (spec §6). Rendered on every surface a forecast number appears.
  confidenceWord    String?
  // Cold-start state (spec §6): "too_new" (no proxy, no prior — never a silent
  // zero) | "borrowed" (shape borrowed from an established similar product) |
  // null (a normal forecast from the product's own history).
  coldStart         String?
  // When coldStart = "borrowed", the established proxy product whose shape was
  // borrowed (owner-picked "sell like", else the engine's auto choice).
  borrowedFromProductId String?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders  Order[]

  @@index([tenantId, runDate])
  @@index([productId, runDate])
  @@index([tenantId, productId, runDate])
  @@index([tenantId, forecastRunId])
}

// Stored forecast-accuracy run — the monthly walk-forward backtest cron writes
// rows so accuracy is tracked over time and the drop-detector can compare runs.
// tenantId-only (no relation). One row per (class × method) plus an "ALL"
// rollup per run, all sharing a runDate.
model BacktestRun {
  id         String   @id @default(cuid())
  tenantId   String
  runDate    DateTime @default(now())
  mae        Float
  bias       Float
  mape       Float?
  sampleSize Int
  tag        String? // "walkforward" (accuracy tracking) | "audition" (champion/challenger)
  // ABC class this row scored ("A" | "B" | "C"), or "ALL" for the whole-shop
  // rollup. null on legacy rows written before by-class tracking.
  abcClass   String?
  // Demand method audited ("run_rate" | "recent_heavy"). null = the reigning
  // champion (legacy). Model names never reach the UI — this is internal.
  method     String?
  // Said-vs-happened in UNITS (spec §6 — the founder rejected error %): total
  // forecast vs total actual units across the scored windows.
  saidUnits     Float?
  happenedUnits Float?
  // Bias direction in plain words: "over" | "under" | "even".
  leans      String?

  @@index([tenantId, runDate])
}

// Owner prior — "tell the forecast something" (spec §6). The owner's stated
// expectation for a product or brand: an expected 30-day level, a multiplier,
// or a cold-start "sell like X" proxy pointer. Listed and revocable (soft-
// delete via revokedAt); the forecast shows it listened. Real sales take over
// as history builds. Same object powers the cold-start starting point.
model OwnerPrior {
  id         String   @id @default(cuid())
  tenantId   String
  scope      String // "product" | "brand"
  scopeValue String // productId (product scope) or vendor/brand name (brand scope)
  // Exactly one expectation form is set:
  expectedUnits  Float? // "I expect about X units / 30 days"
  multiplier     Float? // scale the current forecast by this factor
  proxyProductId String? // cold-start "sell like": the established product to borrow from
  weeks      Int      @default(4) // how long the prior stays in force from createdAt
  note       String?
  createdByUserId String?
  createdByName   String?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime? // soft-delete: still listed, no longer applied

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, scope, scopeValue])
  @@index([tenantId, revokedAt])
}

// Weekly shelf-vs-system spot-check: the app prompts a count of 5 SKUs to
// catch drift between physical shelves and the app's on-hand.
model SpotCheck {
  id         String    @id @default(cuid())
  tenantId   String
  productId  String
  weekKey    String // ISO week, e.g. "2026-W24" — one set of prompts per week
  systemQty  Float // on-hand the app believed when prompting
  countedQty Float? // what the owner physically counted (null until done)
  createdAt  DateTime  @default(now())
  countedAt  DateTime?

  @@index([tenantId, weekKey])
}

// Owner override of the engine's recommended order quantity for a product, set
// on the plan. Keyed by productId (not predictionId): the nightly run wipes and
// recreates every Prediction row, so a prediction-keyed override would vanish —
// this one applies to whichever prediction the next run produces for the product.
model ProductPlanOverride {
  id              String   @id @default(cuid())
  tenantId        String
  productId       String
  qty             Int
  note            String?
  createdByUserId String?
  createdByName   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId])
  @@index([tenantId])
}

// ── Purchasing & audit ───────────────────────────────────────────────────────

model Order {
  id                  String    @id @default(cuid())
  tenantId            String
  // Provenance link to the forecast row that recommended this buy. Nullable +
  // SET NULL: a forecast re-run replaces all Prediction rows, and the order
  // queue / receiving history must survive that — only the link is cleared.
  predictionId        String?
  // pending (queued to buy) → ordered (on a created PO) → completed (its PO
  // lines fully received). cancelled = withdrawn (PO cancelled/deleted).
  status              String    @default("pending")
  shopifyDraftOrderId String?
  approvedAt          DateTime?
  skipReason          String?
  createdAt           DateTime  @default(now())
  purchaseOrderId     String?

  // Reorder tracking / memory (status "ordered" → "received"). Manual "Mark as ordered"
  // records the intent; suppression rides on these fields, NOT Product.onOrder (the nightly
  // Shopify reconcile authoritatively resets onOrder, which would wipe a manual bump).
  productId         String?
  orderedQty        Int?
  orderedAt         DateTime?
  expectedArrivalAt DateTime?
  receivedAt        DateTime?
  stockAtOrder      Float?
  sawEnroute        Boolean   @default(false)

  // Provenance: "app" (button/bulk mark-ordered, the default) vs "qb_external" (a
  // PO/Bill cut directly in QuickBooks, never entered in Wezesha — detected from
  // the daily QB orders feed via SKU/name match, no app PurchaseOrder exists).
  // qbDocRef is the QB doc id/number, used to dedupe re-runs of the daily feed.
  source   String  @default("app")
  qbDocRef String?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  prediction    Prediction?    @relation(fields: [predictionId], references: [id], onDelete: SetNull)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, productId, status])
  @@index([tenantId, qbDocRef])
}

model PurchaseOrder {
  id              String    @id @default(cuid())
  tenantId        String
  supplierId      String?
  vendor          String? // brand label when grouped by brand (suppliers optional)
  poNumber        String
  // Lifecycle: draft | sent | partially_received | received | cancelled.
  // QB evidence track (unused until the QB read-back feed lands): awaiting_qb =
  // expected to be entered into QB; confirmed = a matching Bill/PO was seen.
  status          String    @default("draft")
  currency        String    @default("KES")
  subtotalKes     Float     @default(0)
  createdAt       DateTime  @default(now())
  sentAt          DateTime?
  // ETA promised to the receiving flow: sentAt + supplier lead time when known.
  // On-time scoring compares receivedAt against this.
  expectedAt      DateTime?
  // Who created this order (audit). userId = auth User.id; name = display-name/email
  // snapshot at creation so the PO list shows it without a per-row user lookup.
  createdByUserId String?
  createdByName   String?

  // QB two-stage confirmation (parallel evidence track — never gates Order suppression).
  qbConfirmedAt  DateTime? // set on first QB read-back match
  qbDocRef       String? // QB entity id / DocNumber we matched on (audit + dedupe)
  qbSuggestion   String? // fuzzy lookalike QB doc label (advisory; surfaced in digest/badge, never auto-confirms)
  needsAttention Boolean   @default(false) // phantom: sent but no QB match after M days
  receivedAt     DateTime? // rollup convenience — set when all linked Orders received

  // Accounting trail — never hard-delete a financial record. cancel/delete stamp
  // who + when; soft-deleted POs are filtered from lists but kept in the DB + ledger.
  cancelledAt     DateTime?
  cancelledByName String?
  deletedAt       DateTime?
  deletedByName   String?

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  lines    PurchaseOrderLine[]
  orders   Order[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id              String @id @default(cuid())
  purchaseOrderId String
  tenantId        String // denormalised for RLS (uniform tenant_isolation policy)
  productId       String
  sku             String
  title           String
  quantity        Int
  unitCostKes     Float
  lineTotalKes    Float
  // The model's recommended qty captured at PO creation (before any manual edit),
  // so we can measure recommended-vs-actual later. Null for hand-built lines.
  recommendedQty  Int?
  // Line-by-line receiving: cumulative units checked in (partial deliveries
  // allowed), and when the latest receipt for this line happened.
  receivedQty     Int       @default(0)
  receivedAt      DateTime?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([tenantId])
}

// A saved plan to distribute stock from a warehouse to other locations, sized to
// equalise days-of-cover by each destination's run rate. Plan + CSV only for now
// (the app is read-only to Shopify); a future "apply" could push inventory moves.
model DistributionPlan {
  id             String  @id @default(cuid())
  tenantId       String
  name           String?
  fromLocationId String // warehouse / source location
  status         String  @default("draft") // draft | final | exported
  coverDays      Int     @default(14)
  windowDays     Int     @default(90) // run-rate window used to build it
  createdByName  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromLocation Location               @relation("DistFrom", fields: [fromLocationId], references: [id], onDelete: Cascade)
  lines        DistributionPlanLine[]

  @@index([tenantId])
  @@index([tenantId, status])
}

model DistributionPlanLine {
  id                String @id @default(cuid())
  planId            String
  tenantId          String // denormalised for RLS (uniform tenant_isolation policy)
  productId         String // product id at planning time — deliberately not FK'd; sku/title are snapshots
  sku               String
  title             String
  toLocationId      String
  qty               Int
  fromOnHand        Int    @default(0)
  toOnHand          Int    @default(0)
  toRunRate         Float  @default(0)
  toDaysCoverBefore Float?
  toDaysCoverAfter  Float?
  status            String @default("planned") // planned | picked | sent

  plan       DistributionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  toLocation Location         @relation("DistTo", fields: [toLocationId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([tenantId])
}

// ── Integrations (Shopify) ───────────────────────────────────────────────────

// One Shopify store per tenant. The offline OAuth token is stored as
// AES-256-GCM ciphertext (@wezesha/shopify encrypt()/decrypt(), keyed by
// TOKEN_ENCRYPTION_KEY) — never plaintext. shopDomain is globally unique: it is
// the tenant-resolution key for webhooks, which arrive with no session.
model ShopifyConnection {
  id            String    @id @default(cuid())
  tenantId      String    @unique
  shopDomain    String    @unique // <store>.myshopify.com
  accessToken   String // AES-256-GCM ciphertext
  scopes        String // comma-separated granted scopes, as returned by the token exchange
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime? // set by app/uninstalled webhook or in-app disconnect; null = live

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Per-resource sync high-water mark. The worker re-pulls from cursor minus an
// overlap window, so a crashed run resumes per resource instead of restarting
// the whole sync.
model IngestCursor {
  id        String   @id @default(cuid())
  tenantId  String
  source    String // "shopify"
  resource  String // "products" | "inventory" | "orders"
  cursor    DateTime
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, source, resource])
  @@index([tenantId])
}

// Persisted in-app notifications (the bell). readAt null = unread; the index
// serves the unread-count/badge query.
model Notification {
  id        String    @id @default(cuid())
  tenantId  String
  kind      String // "sync_failed" | "shopify_uninstalled" | ...
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, readAt])
}

// Webhook dedupe ledger — GLOBAL (allow-listed in the rls-coverage census).
// Keyed by Shopify's delivery id, which is checked BEFORE the tenant is
// resolved; rows carry no tenant data. Insert-or-skip on webhookId makes
// redelivered webhooks no-ops.
model WebhookEvent {
  id          String   @id @default(cuid())
  webhookId   String   @unique // X-Shopify-Webhook-Id
  topic       String
  shopDomain  String
  processedAt DateTime @default(now())
}

// Append-only accounting/audit ledger. One row per significant mutation (PO
// created/ordered/cancelled/deleted, cost changed). tenantId-scoped (RLS);
// writes go through the service client — an audit log the tenant role could
// filter is not an audit log.
model AuditEvent {
  id          String   @id @default(cuid())
  tenantId    String
  entity      String // "PurchaseOrder" | "Order" | "Product"
  entityId    String
  action      String // created | edited | ordered | cancelled | received | deleted | cost_changed
  actorUserId String?
  actorName   String?
  meta        Json? // snapshot / before-after detail
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
}
