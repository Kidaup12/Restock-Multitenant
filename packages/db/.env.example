# App role — RLS enforced. All request-path queries run as this role.
DATABASE_URL=postgresql://wezesha_app:wezesha_app_dev@localhost:5434/wezesha

# Service role — BYPASSRLS. Crons, webhooks, auth bootstrap, offline scripts.
SERVICE_DATABASE_URL=postgresql://wezesha_service:wezesha_service_dev@localhost:5434/wezesha

# Owner role — prisma migrate only (schema DDL). Never used by the app.
DIRECT_URL=postgresql://postgres:postgres@localhost:5434/wezesha
