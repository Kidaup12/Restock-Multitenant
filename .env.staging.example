# Local staging stack (docker-compose.staging.yml) — dev defaults only, never
# real credentials. Copy to .env.staging and adjust host ports if other local
# stacks already hold the defaults.
WS_DEV_TOKEN=staging-dev-token
DB_PORT=5434
REDIS_PORT=6380
WS_GATEWAY_PORT=8081
WEB_PORT=3000
# Shopify sync (worker): generate with `openssl rand -base64 32`; leave the URL
# empty to skip webhook registration in the staging rehearsal.
TOKEN_ENCRYPTION_KEY=
SHOPIFY_APP_URL=
